{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.test)",
      "Read(./.env.test.local)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.prod)",
      "Read(./.env.dev)",
      "Read(./.env.backup)",
      "Read(./.env.bak)",
      "Read(./.env.old)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)"
    ]
  },
  "disableBypassPermissionsMode": "disable"
}
