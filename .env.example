# Plantilla. Copiar a ".env" (que NO se sube a GitHub) y completar con valores locales.
# Este archivo solo lleva nombres y valores de ejemplo, nunca secretos reales.
DJANGO_SECRET_KEY=cambiar-por-un-valor-local
DJANGO_DEBUG=True
DB_NAME=carniceria_dev
DB_USER=carniceria_dev
DB_PASSWORD=cambiar-por-un-valor-local
DB_HOST=localhost
DB_PORT=5432

# Contraseña de los usuarios de ejemplo (cargar_datos_ejemplo); solo desarrollo local.
DEMO_PASSWORD=
